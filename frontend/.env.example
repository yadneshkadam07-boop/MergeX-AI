# MergeX AI Frontend Environment Configuration

# Backend API base URL. Use empty string or "/api" for Vite dev proxy
VITE_API_BASE_URL=/api

# Master switch for mock mode (default: true).
# Set to "false" to connect to real FastAPI backend.
VITE_USE_MOCK=true

# Granular mock switches (optional; fallback to VITE_USE_MOCK if not set)
# VITE_MOCK_PROJECTS=true
# VITE_MOCK_ISSUES=true
# VITE_MOCK_ANALYSIS=true
# VITE_MOCK_SETTINGS=true
# VITE_MOCK_AUTH=true

# Artificial mock latency in ms (default: 300)
VITE_MOCK_DELAY_MS=300

# GitHub OAuth Client ID for real social login
VITE_GITHUB_CLIENT_ID=
