# =============================================================================
# MergeX AI - environment template
# Copy to `.env` (repo root) and fill in. `.env` is git-ignored; never commit it.
#   cp .env.example .env
# =============================================================================

# ---- Application -----------------------------------------------------------
# local | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Mount point for the versioned REST API.
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Authentication & Security ---------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT).
# MUST be set to a secure, unpredictable string in production.
JWT_SECRET=mergex-dev-secret-change-in-production-0987654321
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
AUTH_RATE_LIMIT_PER_MINUTE=15
ALLOW_ANONYMOUS_USER=false


# ---- Database --------------------------------------------------------------
# Paste the connection string as your provider gives it to you. A `postgresql://`
# or `postgres://` prefix is rewritten to `postgresql+asyncpg://` automatically,
# and a `?sslmode=require` suffix is translated into asyncpg's own SSL option
# (asyncpg rejects `sslmode`), so no hand-editing is needed.
#
#   local docker compose : postgresql+asyncpg://mergex:mergex@db:5432/mergex
#   local, host-side     : postgresql+asyncpg://mergex:mergex@localhost:5432/mergex
#   Supabase direct      : Dashboard > Connect > "Direct connection" (port 5432)
#   Supabase pooled      : Dashboard > Connect > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql+asyncpg://mergex:mergex@localhost:5432/mergex

# Set true ONLY for a pooled Supabase URL (port 6543) or any pgbouncer in
# transaction mode: a prepared statement cannot outlive its transaction there,
# which otherwise fails with
#   prepared statement "__asyncpg_stmt_1__" does not exist
# Leave false for a direct connection (port 5432) and for local Postgres.
# Note: migrations should always be run against the DIRECT connection.
DB_DISABLE_PREPARED_STATEMENTS=false

# Connection pool sizing. Ignored when DB_DISABLE_PREPARED_STATEMENTS is true.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Log every statement. Noisy; useful when debugging a query.
DB_ECHO=false

# Credentials consumed by the Postgres container in docker-compose.yml.
# Irrelevant when DATABASE_URL points at Supabase.
POSTGRES_USER=mergex
POSTGRES_PASSWORD=mergex
POSTGRES_DB=mergex
POSTGRES_PORT=5432

# ---- Gemini (AI explanations only, never issue detection) ------------------
# https://aistudio.google.com/apikey  -- leave blank to run analysis without AI
# explanations; findings are still produced by the deterministic engines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Per-request timeout and retry budget for the Gemini client.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# ---- GitHub ----------------------------------------------------------------
# Optional. A classic/fine-grained PAT with `public_repo` raises the REST rate
# limit from 60 to 5000 requests/hour and allows importing private repos.
GITHUB_TOKEN=

# ---- Analysis sandbox limits (platform safety) -----------------------------
# Imported repositories are cloned/extracted here, then deleted.
WORKSPACE_DIR=./.workspace
# Hard caps. Imports exceeding these are rejected before analysis starts.
MAX_REPO_SIZE_MB=100
MAX_FILE_COUNT=20000
MAX_UPLOAD_SIZE_MB=100
# Wall-clock budget for one end-to-end analysis run.
ANALYSIS_TIMEOUT_SECONDS=600
# Wall-clock budget for a single `git clone`.
CLONE_TIMEOUT_SECONDS=120

# ---- Rate limiting ---------------------------------------------------------
# Requests allowed per client per minute. Health probes and /docs are exempt.
RATE_LIMIT_PER_MINUTE=60
# Read the client address from X-Forwarded-For. Set true ONLY when running
# behind a proxy that overwrites that header (Render, a load balancer).
# Enabling it on a directly-exposed service lets clients forge a new identity
# per request and bypass the limit completely.
TRUST_PROXY_HEADERS=false

# ---- Demo project ----------------------------------------------------------
# POST /api/v1/projects/demo is unauthenticated and does real work (packs the
# bundled fixture, imports it, runs a full analysis), so it has its own limit
# per client address on top of RATE_LIMIT_PER_MINUTE.
DEMO_RATE_LIMIT_PER_HOUR=5
# Strict per-minute cap on the same endpoint (primary abuse barrier).
DEMO_RATE_LIMIT_PER_MINUTE=5
# Short-window burst guard on top of the hourly cap.
# DEMO_BURST_LIMIT requests per DEMO_BURST_WINDOW_MINUTES minutes per IP.
# Prevents a script from draining the hourly budget in one second.
DEMO_BURST_LIMIT=2
DEMO_BURST_WINDOW_MINUTES=10
# Demo projects are disposable; a background task deletes them after this long
# and removes their retained archives.
DEMO_RETENTION_HOURS=24
# How often that task runs.
DEMO_CLEANUP_INTERVAL_MINUTES=60

# ---- External services -----------------------------------------------------
# OSV.dev vulnerability database (no API key required).
OSV_API_URL=https://api.osv.dev/v1/querybatch

# ---- Frontend (Vite; only VITE_* vars reach the browser) -------------------
VITE_API_BASE_URL=http://localhost:8000
