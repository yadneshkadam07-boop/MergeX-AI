# =============================================================================
# MergeX AI - environment template
# Copy to `.env` (repo root) and fill in. `.env` is git-ignored; never commit it.
#   cp .env.example .env
# =============================================================================

# ---- Application -----------------------------------------------------------
# local | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Mount point for the versioned REST API.
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database --------------------------------------------------------------
# Async SQLAlchemy URL. Host is `db` inside docker compose, `localhost` otherwise.
DATABASE_URL=postgresql+asyncpg://mergex:mergex@localhost:5432/mergex
# Credentials consumed by the Postgres container in docker-compose.yml.
POSTGRES_USER=mergex
POSTGRES_PASSWORD=mergex
POSTGRES_DB=mergex
POSTGRES_PORT=5432

# ---- Gemini (AI explanations only, never issue detection) ------------------
# https://aistudio.google.com/apikey  -- leave blank to run analysis without AI
# explanations; findings are still produced by the deterministic engines.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Per-request timeout and retry budget for the Gemini client.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# ---- GitHub ----------------------------------------------------------------
# Optional. A classic/fine-grained PAT with `public_repo` raises the REST rate
# limit from 60 to 5000 requests/hour and allows importing private repos.
GITHUB_TOKEN=

# ---- Analysis sandbox limits (platform safety) -----------------------------
# Imported repositories are cloned/extracted here, then deleted.
WORKSPACE_DIR=./.workspace
# Hard caps. Imports exceeding these are rejected before analysis starts.
MAX_REPO_SIZE_MB=100
MAX_FILE_COUNT=20000
MAX_UPLOAD_SIZE_MB=100
# Wall-clock budget for one end-to-end analysis run.
ANALYSIS_TIMEOUT_SECONDS=600
# Wall-clock budget for a single `git clone`.
CLONE_TIMEOUT_SECONDS=120

# ---- Rate limiting ---------------------------------------------------------
# Requests allowed per client per minute. Health probes and /docs are exempt.
RATE_LIMIT_PER_MINUTE=60
# Read the client address from X-Forwarded-For. Set true ONLY when running
# behind a proxy that overwrites that header (Render, a load balancer).
# Enabling it on a directly-exposed service lets clients forge a new identity
# per request and bypass the limit completely.
TRUST_PROXY_HEADERS=false

# ---- External services -----------------------------------------------------
# OSV.dev vulnerability database (no API key required).
OSV_API_URL=https://api.osv.dev/v1/querybatch

# ---- Frontend (Vite; only VITE_* vars reach the browser) -------------------
VITE_API_BASE_URL=http://localhost:8000
